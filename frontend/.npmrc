# Node yang terlalu tua harus gagal dengan pesan yang bisa dibaca, bukan gagal jauh di dalam
# build dengan sebab yang tidak jelas. Vite 8 menuntut ^20.19 || >=22.12, dan tanpa baris ini
# npm cuma memberi peringatan yang tenggelam di antara ratusan baris log.
engine-strict=true

# INSTALL SCRIPT DIMATIKAN, dan ini yang membuat build web tidak bisa digagalkan `sharp`.
#
# `@capacitor/assets` (devDependency) menarik `sharp@0.32.6`, yang punya install script native:
# dia mengunduh binary prebuilt atau jatuh ke `node-gyp rebuild`. GitHub Actions punya toolchain
# untuk itu; image build Vercel belum tentu. `npm ci` yang gagal di install berarti build yang
# gagal sebelum satu baris kode dibaca — dan itu asimetri "CI hijau, Vercel merah" yang mahal.
#
# KENAPA DI SINI, BUKAN DI `vercel.json`. Perbaikan lewat `npm ci --ignore-scripts` di
# `buildCommand` HANYA berlaku kalau Vercel membaca `vercel.json` di akar repo — dan dia cuma
# membacanya kalau Root Directory project disetel ke akar. Kalau Root Directory disetel ke
# `frontend`, `vercel.json` di akar tidak pernah dibaca sama sekali, Vercel mendeteksi Vite
# sendiri, dan perbaikan itu tidak berlaku. Berkas ini berlaku di KEDUA konfigurasi, dan juga
# untuk siapa pun yang menjalankan `npm install` di mesinnya.
#
# Aman karena tidak ada satu pun skrip atau workflow yang menjalankan `@capacitor/assets` — dia
# dipanggil manual, sekali, saat men-generate ikon Android. Kalau butuh:
#   npm rebuild sharp --ignore-scripts=false
#   npx @capacitor/assets generate ...
# Lihat docs/MOBILE.md.
ignore-scripts=true
