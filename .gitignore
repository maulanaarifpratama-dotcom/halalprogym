# Exercise media — fetched on first `docker compose up` (or via scripts/fetch-media.sh)
media/img/
media/gif/

# Runtime data — users, passkeys, per-user state, session secret
data/

# Local config — nilai kredensial TIDAK PERNAH masuk git.
# Pola `.env` saja tidak menangkap .env.local / .env.production; repo ini publik
# (AGPL), jadi satu key ter-commit langsung terekspos.
.env
.env.*
!.env.example

# KUNCI PENANDATANGANAN ANDROID — tidak pernah masuk git.
#
# Siapa pun yang memiliki berkas ini bisa menerbitkan pembaruan yang dipasang DI ATAS app
# orang. Dan berbeda dari kredensial lain, dia tidak bisa dirotasi: Android mengikat identitas
# app ke tanda tangannya, jadi kunci yang bocor tidak bisa diganti tanpa memaksa setiap
# pengguna uninstall dan kehilangan datanya.
#
# Repo ini publik (AGPL), jadi satu commit yang salah langsung mengeksposnya selamanya.
*.jks
*.keystore
keystore.properties
frontend/android/key.properties

# Keluaran build Android
frontend/android/app/build/
frontend/android/build/
frontend/android/.gradle/
frontend/android/local.properties
frontend/android/app/src/main/assets/public/

# Foto demo gerakan yang diunduh untuk APK (scripts/fetch-demo-media.mjs). Lisensinya
# Unlicense jadi boleh di-commit, tapi 39 MB biner di git berarti setiap clone membayarnya
# selamanya. Diunduh saat build. SENGAJA di luar public/: Vite menyalin public/ ke dist/ di
# SETIAP build, jadi di sana build WEB ikut membawa 39 MB yang tidak dipakai sama sekali —
# terukur, dist jadi 49 MB, dan itu terkirim ke Vercel tiap deploy.
frontend/media-cache/

# Build output / deps
frontend/dist/
node_modules/
*.log
.DS_Store
node_modules
.claude/
.agents/

# Scratch Supabase CLI (cli-latest, dsb). Bukan konfigurasi, bukan migration.
supabase/.temp/
